# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for each client.

# --- Site -------------------------------------------------------------------
# Public URL of the site, no trailing slash (used for SEO, emails, Stripe redirects, iCal links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "anon" / publishable key. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / secret key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (the CLIENT'S own account: Developers → API keys) -----------------
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the webhook endpoint https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=re_...
# Must be an address on a domain verified in Resend, e.g. "Client Name <bookings@clientdomain.com>".
EMAIL_FROM=
# Where booking / inquiry / contact-form notifications go. Defaults to contact.email in site.config.ts.
HOST_NOTIFICATION_EMAIL=

# --- Scheduled jobs -----------------------------------------------------------
# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Demo mode ----------------------------------------------------------------
# true = spec-demo site: payments disabled, "Booking available soon", "Preview site" banner.
DEMO_MODE=false

# --- Automated tests only (never set in production) ---------------------------
# Point the Stripe and Resend SDKs at the local mock (node tests/mock-services.cjs).
# STRIPE_API_BASE_URL=http://localhost:12111
# RESEND_BASE_URL=http://localhost:12111
